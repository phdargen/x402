{
  "name": "@x402/cli",
  "version": "2.28.0",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "x402": "./dist/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "build": "tsup",
    "watch": "tsc --watch",
    "format": "prettier -c .prettierrc --write \"**/*.{ts,js,cjs,json,md}\"",
    "format:check": "prettier -c .prettierrc --check \"**/*.{ts,js,cjs,json,md}\"",
    "lint": "eslint . --ext .ts --fix",
    "lint:check": "eslint . --ext .ts"
  },
  "keywords": [
    "x402",
    "payment",
    "protocol",
    "cli",
    "wallet"
  ],
  "license": "Apache-2.0",
  "author": "x402 Foundation",
  "repository": "https://github.com/x402-foundation/x402",
  "description": "x402 command-line client with pluggable wallets",
  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@solana/kit": "^5.3.0",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "@vitest/coverage-v8": "^3.2.7",
    "@x402/evm": "workspace:~",
    "@x402/svm": "workspace:~",
    "eslint": "^9.24.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^50.6.9",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-sonarjs": "^3.0.7",
    "prettier": "3.5.2",
    "tsup": "^8.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3",
    "viem": "^2.48.11",
    "vite": "^6.2.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "@x402/core": "workspace:~",
    "@x402/fetch": "workspace:~",
    "incur": "^0.7.1"
  },
  "peerDependencies": {
    "@solana/kit": ">=5.1.0",
    "@x402/evm": "workspace:^",
    "@x402/svm": "workspace:^",
    "viem": "^2.48.11"
  },
  "peerDependenciesMeta": {
    "@solana/kit": {
      "optional": true
    },
    "@x402/evm": {
      "optional": true
    },
    "@x402/svm": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./evm": {
      "types": "./dist/evm.d.ts",
      "default": "./dist/evm.js"
    },
    "./svm": {
      "types": "./dist/svm.d.ts",
      "default": "./dist/svm.js"
    }
  },
  "files": [
    "dist"
  ]
}
