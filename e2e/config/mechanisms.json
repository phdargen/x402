  "harnessEnv": {
    "server": {
      "required": [
        "PORT",
        "FACILITATOR_URL"
      ],
      "optional": [
        "SERVER_EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY",
        "EVM_PERMIT2_ASSET",
        "MOCK_FACILITATOR_URL"
      ]
    },
    "client": {
      "required": [
        "RESOURCE_SERVER_URL",
        "ENDPOINT_PATH"
      ],
      "optional": [
        "CHANNEL_SALT",
        "BATCH_SETTLEMENT_PHASE",
        "BATCH_SETTLEMENT_RECOVERY",
        "CLIENT_EVM_VOUCHER_SIGNER_PRIVATE_KEY",
        "TVM_PROVIDER",
        "TONCENTER_API_KEY",
        "TONCENTER_BASE_URL",
        "TONAPI_API_KEY",
        "TONAPI_BASE_URL"
      ]
    },
    "facilitator": {
      "required": [
        "PORT"
      ],
      "optional": [
        "SERVER_EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY",
        "TVM_PROVIDER",
        "TONCENTER_API_KEY",
        "TONCENTER_BASE_URL",
        "TONAPI_API_KEY",
        "TONAPI_BASE_URL"
      ]
    }
  },
