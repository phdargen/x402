{
  "env": {
    "required": [],
    "optional": [
      "SERVER_XRPL_ADDRESS",
      "CLIENT_XRPL_SEED"
    ]
  },
  "rpcUrlKey": "XRPL_WS_URL",
  "testnet": {
    "name": "XRPL Testnet",
    "caip2": "xrpl:1",
    "rpcUrlEnv": "XRPL_TESTNET_WS_URL",
    "rpcUrlDefault": "wss://s.altnet.rippletest.net:51233"
  },
  "mainnet": {
    "name": "XRPL",
    "caip2": "xrpl:0",
    "rpcUrlEnv": "XRPL_MAINNET_WS_URL",
    "rpcUrlDefault": "wss://s1.ripple.com:51233"
  },
  "routes": {
    "/exact/xrpl/sequence": {
      "scheme": "exact",
      "assetTransferMethod": "sequence",
      "sdks": ["typescript"],
      "price": {
        "amount": "1000",
        "amountEnv": "SERVER_XRPL_AMOUNT",
        "asset": "XRP",
        "assetEnv": "SERVER_XRPL_ASSET",
        "extraEnv": {
          "issuer": {
            "env": "SERVER_XRPL_ISSUER",
            "whenAssetOverridden": true
          }
        }
      },
      "extensions": ["bazaar"]
    },
    "/exact/xrpl/ticketSequence": {
      "scheme": "exact",
      "assetTransferMethod": "ticketSequence",
      "sdks": ["typescript"],
      "price": {
        "amount": "1000",
        "amountEnv": "SERVER_XRPL_AMOUNT",
        "asset": "XRP",
        "assetEnv": "SERVER_XRPL_ASSET",
        "extraEnv": {
          "issuer": {
            "env": "SERVER_XRPL_ISSUER",
            "whenAssetOverridden": true
          }
        }
      },
      "extensions": ["bazaar"]
    }
  }
}
