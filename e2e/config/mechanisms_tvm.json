{
  "env": {
    "required": [],
    "optional": [
      "SERVER_TVM_ADDRESS",
      "CLIENT_TVM_PRIVATE_KEY",
      "FACILITATOR_TVM_PRIVATE_KEY",
      "TVM_PROVIDER",
      "TVM_TONCENTER_API_KEY",
      "TVM_TONAPI_API_KEY"
    ]
  },
  "testnet": {
    "name": "TON Testnet",
    "caip2": "tvm:-3",
    "rpcUrlDefault": "https://testnet.toncenter.com"
  },
  "mainnet": {
    "name": "TON Mainnet",
    "caip2": "tvm:-239",
    "rpcUrlDefault": "https://toncenter.com"
  },
  "routes": {
    "/exact/tvm": {
      "scheme": "exact",
      "sdks": ["typescript", "python"],
      "price": { "usd": "$0.001" },
      "extensions": ["bazaar"]
    }
  }
}
