{
  "env": {
    "required": [],
    "optional": [
      "SERVER_STELLAR_ADDRESS",
      "CLIENT_STELLAR_PRIVATE_KEY",
      "FACILITATOR_STELLAR_PRIVATE_KEY"
    ]
  },
  "testnet": {
    "name": "Stellar Testnet",
    "caip2": "stellar:testnet",
    "rpcUrlDefault": "https://soroban-testnet.stellar.org"
  },
  "mainnet": {
    "name": "Stellar Pubnet",
    "caip2": "stellar:pubnet",
    "rpcUrlDefault": "https://mainnet.sorobanrpc.com"
  },
  "routes": {
    "/exact/stellar": {
      "scheme": "exact",
      "sdks": ["typescript"],
      "price": { "usd": "$0.001" },
      "extensions": ["bazaar"]
    }
  }
}
