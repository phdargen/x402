# XMTP Client (from xmtp_skills building-agents)
XMTP_ENV=dev
XMTP_WALLET_KEY=0x...
XMTP_DB_ENCRYPTION_KEY=0x...

# Payment signer (can match XMTP_WALLET_KEY)
EVM_PRIVATE_KEY=0x...

# Resource agent address (from server's agent.address)
RESOURCE_AGENT_ADDRESS=0x...

# Optional: message to send (default: weather)
# REQUEST_MESSAGE=weather
