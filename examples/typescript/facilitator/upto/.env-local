# At least one of EVM_PRIVATE_KEY or SVM_PRIVATE_KEY is required.
EVM_PRIVATE_KEY=0x...
SVM_PRIVATE_KEY=

EVM_RPC_URL=https://sepolia.base.org
SVM_RPC_URL=

# Rent cleanup (SVM only). Interval between cleanup ticks in seconds.
RENT_CLEANUP_INTERVAL_SECS=300
# Seconds before an Open channel may be abandon-closed (default 3600).
RENT_CLEANUP_ABANDON_TIMEOUT_SECS=3600

PORT=
