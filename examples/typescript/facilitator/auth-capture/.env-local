EVM_PRIVATE_KEY=0x...
EVM_RPC_URL=https://sepolia.base.org

# Optional dedicated receiver authorizer (recommended: separate from relayer).
# When set, advertised in GET /supported as extra.receiverAuthorizer for delegated sync/deferred routes.
EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=

# Optional facilitator fee bounds (defaults: zeroAddress / 0 bps).
FEE_RECIPIENT=
MIN_FEE_BPS=0
MAX_FEE_BPS=0

PORT=
