EVM_PRIVATE_KEY=0x...
EVM_RPC_URL=https://sepolia.base.org

# Optional dedicated authorizer key. Required when VOUCHER_STORE is enabled.
EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=

# Facilitator-managed voucher custody (spec v1.1). Pair with VOUCHER_STORE_MODE=facilitator on the server.
# VOUCHER_STORE=true
# VOUCHER_STORE_DIR=./voucher-store   # optional; omit for in-memory (default)
# VOUCHER_STORE_WITHDRAW_DELAY_SECONDS=900

# Verbose facilitator lifecycle hook dumps (default off). HTTP routes still log one-line status.
# DEBUG=true

# Optional (default 4022). Same as examples/go/facilitator/batch-settlement.
PORT=
