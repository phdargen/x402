EVM_PRIVATE_KEY=0x...
EVM_RPC_URL=https://sepolia.base.org

# Deployed x402BatchSettlementGateway address for this facilitator
GATEWAY_ADDRESS=0x...

# Facilitator withdrawDelay policy (seconds), advertised via /supported extensionInfo
WITHDRAW_DELAY_SECONDS=900

# Optional dedicated authorizer key (defaults to unset — servers supply claim auth)
EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=

# Optional file-backed gateway storage directory
STORAGE_DIR=

# Optional (default 4022)
PORT=
