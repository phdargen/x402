# Copy this file to .env and fill in your values

# Your EVM wallet address to receive payments
EVM_ADDRESS=0xYourAddressHere

# x402 Facilitator URL
FACILITATOR_URL=https://facilitator.x402.org

# (Optional) Port to run the server on
PORT=4022

# ============================================================================
# Signer Configuration
# ============================================================================

# Choose signing mode: "jws" (default) or "eip712"
SIGNER_MODE=jws

# --- JWS Mode Configuration ---
# (Optional) Your signing key in PEM format for JWS signatures
# If not provided, an ephemeral key will be generated (not for production!)
# SIGNING_KEY_PEM="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# (Optional) Key identifier DID for your JWS signing key
# SIGNING_KEY_KID=did:web:your-domain.com#key-1

# --- EIP-712 Mode Configuration ---
# Required when SIGNER_MODE=eip712
# Your Ethereum private key (hex string with 0x prefix)
# PRIVATE_KEY=0x...
