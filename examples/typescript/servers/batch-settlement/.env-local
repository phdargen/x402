EVM_ADDRESS=0x...
FACILITATOR_URL=http://localhost:4022

# Self-managed mode (default): local receiver authorizer. Channels survive facilitator changes.
# Omit to delegate to the facilitator's advertised authorizer (channels bind to that facilitator).
EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY=

# Facilitator-managed mode: set to "facilitator" and VOUCHER_STORE=true on the facilitator.
# Do not set EVM_RECEIVER_AUTHORIZER_PRIVATE_KEY in this mode.
# VOUCHER_STORE_MODE=facilitator
# EVM_REFUND_AUTHORIZER_PRIVATE_KEY=0x...  # cooperative refunds (or use facilitator refundAuth)

STORAGE_DIR=
DEFERRED_WITHDRAW_DELAY_SECONDS=900
